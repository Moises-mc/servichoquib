# Copia este archivo a server/.env para desarrollo local. No subir .env al repositorio.
NODE_ENV=development
PORT=8000
CLIENT_ORIGIN=http://localhost:5500,hhttps://servichoquib.vercel.app/,https://moises-mc.github.io
JWT_SECRET=local-only-replace-with-a-random-secret-of-at-least-32-characters
SEED_DEMO_DATA=true

# Local PostgreSQL. En Vercel utiliza DATABASE_URL de Neon y no estas credenciales.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_SCHEMA=servi_choquib
DB_POOL_MAX=5
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# En producción (Vercel): NODE_ENV=production, DATABASE_URL=<Neon pooled URL>,
# CLIENT_ORIGIN=https://moises-mc.github.io, JWT_SECRET=<random >= 32 chars>,
# DB_SCHEMA=servi_choquib, DB_POOL_MAX=1, SEED_DEMO_DATA=false.
