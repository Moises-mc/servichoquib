# Local development. Never commit .env or put DATABASE_URL in frontend JS.
NODE_ENV=development
PORT=8000
CLIENT_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
JWT_SECRET=local-only-replace-before-production-with-random-32-plus-chars
SEED_DEMO_DATA=true
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_SCHEMA=servi_choquib
DB_POOL_MAX=5
DB_SSL=false
